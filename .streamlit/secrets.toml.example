# LOCAL USE: copy this file to .streamlit/secrets.toml and fill in your keys
# STREAMLIT CLOUD: paste the same content into your app's "Secrets" settings
# in the Streamlit Community Cloud dashboard — never commit the real file.

GEMINI_API_KEY = "your_gemini_api_key_here"
GROQ_API_KEY = "your_groq_api_key_here"
